DESCRIPTION >
    Unique visitors grouped by country for a site/date range.
    Consumed exclusively by the Dashboard API Server.

NODE ranked
SQL >
    %
    SELECT
        country,
        uniqExact(visitor_hash) AS unique_visitors,
        count() AS events,
        countIf(type = 'pageview') AS pageviews
    FROM analytics_events
    WHERE site_id = {{ String(site_id, required=True) }}
      AND country IS NOT NULL
      AND country != ''
      AND country != 'XX'
      {% if defined(date_from) %}
      AND timestamp >= {{ DateTime(date_from) }}
      {% end %}
      {% if defined(date_to) %}
      AND timestamp <= {{ DateTime(date_to) }}
      {% end %}
    GROUP BY country
    ORDER BY unique_visitors DESC

TYPE endpoint