DESCRIPTION >
    Top referring domains for a site/date range.
    Consumed exclusively by the Dashboard API Server.

NODE ranked
SQL >
    %
    SELECT
        referrer,
        count() AS visits,
        uniqExact(visitor_hash) AS unique_visitors
    FROM analytics_events
    WHERE site_id = {{ String(site_id, required=True) }}
      AND referrer IS NOT NULL
      AND referrer != ''
      {% if defined(date_from) %}
      AND timestamp >= {{ DateTime(date_from) }}
      {% end %}
      {% if defined(date_to) %}
      AND timestamp <= {{ DateTime(date_to) }}
      {% end %}
    GROUP BY referrer
    ORDER BY visits DESC
    LIMIT 50

TYPE endpoint
