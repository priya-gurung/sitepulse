# ---- Neon PostgreSQL (OLTP) ----
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/sitepulse?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-xxx.neon.tech/sitepulse?sslmode=require"

# ---- Kafka ----
# Comma-separated list of broker host:port pairs.
KAFKA_BROKERS="localhost:9092"
KAFKA_CONSUMER_GROUP="sitepulse-worker"
# How many times the worker retries a message before routing it to the
# analytics-events-dlq topic instead of blocking the partition forever.
WORKER_MAX_ATTEMPTS=3

# ---- Tinybird (OLAP) ----
TINYBIRD_HOST="https://api.tinybird.co"
TINYBIRD_INGEST_TOKEN="p.ey..."   # scoped: APPEND on analytics_events
TINYBIRD_READ_TOKEN="p.ey..."     # scoped: READ on pipes only

# ---- AI Agent (FastAPI + LangGraph microservice) ----
# Base URL only — the dashboard server appends /ask itself. This service
# is called exclusively by the dashboard server, only after the request
# has been authenticated (JWT) and authorized (site ownership check).
AI_SERVICE_URL="http://localhost:8000"

# ---- Auth ----
JWT_SECRET="change-me-to-a-long-random-string"

# ---- Privacy ----
# Rotate this periodically (e.g. daily via a scheduled job) to bound
# cross-day visitor correlation. Must be identical across all ingestion
# server + worker instances at any given moment.
VISITOR_HASH_SALT="change-me-rotate-daily"

# ---- Ports ----
INGESTION_PORT=4001
DASHBOARD_PORT=4002

# ---- CORS ----
DASHBOARD_ALLOWED_ORIGIN="https://app.sitepulse.example.com"

# ---- OpenTelemetry ----
# Unique per service — if you run multiple services on one machine
# outside Docker, give each a distinct OTEL_SERVICE_NAME and
# OTEL_PROMETHEUS_PORT so they don't collide.
OTEL_SERVICE_NAME="ingestion-server"
# Base URL of an OTLP HTTP receiver (Jaeger, an OTel Collector, etc).
# Traces are POSTed to `${OTEL_EXPORTER_OTLP_ENDPOINT}/v1/traces`.
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
# Prometheus scrape port for this service's metrics (exposed at /metrics).
OTEL_PROMETHEUS_PORT=9464

NODE_ENV=production
# Worker parallelism now comes from Kafka partition count + worker
# replica count (see docker-compose.yml `worker.deploy.replicas`), not a
# per-process concurrency setting — each partition is consumed by exactly
# one consumer in the group at a time.
